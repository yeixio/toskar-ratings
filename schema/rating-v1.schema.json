{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yeixio/toskar-ratings/schema/rating-v1.schema.json",
  "title": "Toskar community model rating, version 1",
  "description": "What Toskar sends when a person chooses to share a rating, from a computer or from a phone or tablet. No names, device models, addresses, prompts, responses, or files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_id", "model", "runtime", "hardware", "stars"],
  "properties": {
    "schema_version": {"const": 1},
    "client_id": {"type": "string", "pattern": "^[a-f0-9]{32,64}$", "description": "Random, made once per installation; never derived from hardware."},
    "model": {
      "type": "object", "additionalProperties": false, "required": ["id", "format", "quantization"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,99}$", "description": "Base model slug, such as qwen2.5-coder-7b-instruct."},
        "format": {"enum": ["gguf", "mlx", "safetensors", "onnx"]},
        "quantization": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,23}$"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["type", "backend"],
      "properties": {
        "type": {"enum": ["llamacpp", "mlx", "vllm", "ollama", "external", "llama.rn"], "description": "llama.rn is the on-device runtime on phones and tablets, and only there."},
        "backend": {"enum": ["metal", "cuda", "rocm", "vulkan", "sycl", "opencl", "cpu"]},
        "version": {"type": "string", "pattern": "^[0-9A-Za-z.+-]{1,32}$"}
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "vendor", "family", "memory_type", "memory_bucket_gb"],
      "properties": {
        "platform": {"enum": ["macos", "linux", "windows", "ios", "ipados", "android"]},
        "architecture": {"enum": ["arm64", "amd64"]},
        "vendor": {"enum": ["apple", "nvidia", "amd", "intel", "cpu", "qualcomm", "samsung", "google", "mediatek"], "description": "On a phone or tablet, the chip maker: apple on ios and ipados; qualcomm, samsung, google, or mediatek on android."},
        "family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "Accelerator model, such as m4-max or rtx-4090; for cpu, the CPU vendor. On a phone or tablet, the chip, such as a17-pro, snapdragon-8-gen-3, exynos-2400, tensor-g3, or dimensity-9300; never the device model."},
        "memory_type": {"enum": ["unified", "dedicated", "system"]},
        "memory_bucket_gb": {"enum": ["0-8", "8-16", "16-32", "32-64", "64-128", "128+", "0-4", "4-8", "8-12", "12-16", "16-24", "24+"], "description": "Computers: the memory the model can use, 0-8 to 128+. Phones and tablets: the device memory rounded to the nearest GB, 0-4 to 24+, each band including its lower bound."}
      }
    },
    "stars": {"type": "integer", "minimum": 1, "maximum": 5},
    "tags": {
      "type": "array", "uniqueItems": true, "maxItems": 10,
      "items": {"enum": ["great_responses", "fast", "slow", "stable", "crashed", "too_much_memory", "great_for_coding", "great_for_chat", "good_tool_use", "poor_tool_use"]}
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "description": "Optional, shared only when the person agrees.",
      "properties": {
        "tokens_per_second": {"type": "number", "minimum": 0, "maximum": 10000},
        "ttft_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
        "starts": {"type": "integer", "minimum": 0, "maximum": 100000},
        "start_failures": {"type": "integer", "minimum": 0},
        "crashed": {"type": "boolean"},
        "out_of_memory": {"type": "boolean"},
        "context_band": {"enum": ["0-8k", "8-32k", "32-128k", "128k+"]}
      }
    },
    "app_version": {"type": "string", "pattern": "^[0-9A-Za-z.+-]{1,32}$"},
    "language": {"type": "string", "pattern": "^([a-z]{2,3}|zh-Hans|zh-Hant)$", "description": "The language the model was used in, as a base tag such as es (zh-Hans or zh-Hant for Chinese), when the person chose to say. Never published with hardware."}
  },
  "allOf": [
    {
      "description": "A phone or tablet runs llama.rn on metal, opencl, or cpu, with its chip, unified memory, a phone memory band, and plain numeric versions.",
      "if": {"properties": {"hardware": {"properties": {"platform": {"enum": ["ios", "ipados", "android"]}}, "required": ["platform"]}}, "required": ["hardware"]},
      "then": {
        "properties": {
          "runtime": {"properties": {"type": {"const": "llama.rn"}, "backend": {"enum": ["metal", "opencl", "cpu"]}, "version": {"pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"}}},
          "hardware": {"properties": {"memory_type": {"const": "unified"}, "memory_bucket_gb": {"enum": ["0-4", "4-8", "8-12", "12-16", "16-24", "24+"]}}},
          "app_version": {"pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"}
        }
      },
      "else": {
        "properties": {
          "runtime": {"properties": {"type": {"not": {"const": "llama.rn"}}}},
          "hardware": {"properties": {"vendor": {"enum": ["apple", "nvidia", "amd", "intel", "cpu"]}, "memory_bucket_gb": {"enum": ["0-8", "8-16", "16-32", "32-64", "64-128", "128+"]}}}
        }
      }
    },
    {
      "if": {"properties": {"hardware": {"properties": {"platform": {"enum": ["ios", "ipados"]}}, "required": ["platform"]}}, "required": ["hardware"]},
      "then": {"properties": {"hardware": {"properties": {"vendor": {"const": "apple"}, "family": {"pattern": "^(a[0-9]{1,2}[xz]?(-pro|-bionic)?|m[0-9]{1,2}(-pro|-max|-ultra)?)$"}}}}}
    },
    {
      "if": {"properties": {"hardware": {"properties": {"platform": {"const": "android"}}, "required": ["platform"]}}, "required": ["hardware"]},
      "then": {
        "properties": {"hardware": {"properties": {"vendor": {"enum": ["qualcomm", "samsung", "google", "mediatek"]}}}},
        "allOf": [
          {"if": {"properties": {"hardware": {"properties": {"vendor": {"const": "qualcomm"}}}}}, "then": {"properties": {"hardware": {"properties": {"family": {"pattern": "^snapdragon-([0-9]{3}g?(-plus)?|[0-9](s|-plus)?-(gen-[0-9]|elite(-gen-[0-9])?))$"}}}}}},
          {"if": {"properties": {"hardware": {"properties": {"vendor": {"const": "samsung"}}}}}, "then": {"properties": {"hardware": {"properties": {"family": {"pattern": "^exynos-[0-9]{3,4}$"}}}}}},
          {"if": {"properties": {"hardware": {"properties": {"vendor": {"const": "google"}}}}}, "then": {"properties": {"hardware": {"properties": {"family": {"pattern": "^tensor(-g[0-9]{1,2})?$"}}}}}},
          {"if": {"properties": {"hardware": {"properties": {"vendor": {"const": "mediatek"}}}}}, "then": {"properties": {"hardware": {"properties": {"family": {"pattern": "^(dimensity-[0-9]{3,4}(-plus|-ultra|-max)?|helio-[agpx][0-9]{2,3})$"}}}}}}
        ]
      }
    }
  ]
}
